#!/usr/bin/env python3
"""Check an explicitly configured HTTPS route and authenticated WebSocket access."""
import argparse
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import secrets
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader("paseo_manage", str(ROOT / "services/paseo/manage"))
spec = importlib.util.spec_from_loader(loader.name, loader)
m = importlib.util.module_from_spec(spec)
loader.exec_module(m)


def status(hostname, path, password=None):
    headers = {"User-Agent": "infra-gateway-verifier/1.0"}
    if password:
        headers["Authorization"] = "Bearer " + password
    req = urllib.request.Request("https://" + hostname + path, headers=headers)
    # Do not forward a daemon password if an external policy redirects the request.
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None
    opener = urllib.request.build_opener(NoRedirect)
    try:
        with opener.open(req, timeout=15) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code


def main(instance, hostname=None):
    c = m.config(instance)
    if not hostname:
        if len(c["hostnames"]) != 1:
            raise ValueError("Declare one gateway route or select --hostname explicitly")
        hostname = c["hostnames"][0]
    if hostname not in c["hostnames"]:
        raise ValueError("Hostname is not declared for this backend in config.toml gateway.routes")
    password = m.password_file(instance).read_text().strip()
    for path, credential, expected, label in [
        ("/", None, 200, "web UI"),
        ("/api/status", None, 401, "unauthenticated API"),
        ("/api/status", secrets.token_urlsafe(32), 401, "wrong-password API"),
        ("/api/status", password, 200, "authenticated API"),
    ]:
        actual = status(hostname, path, credential)
        if actual != expected:
            raise RuntimeError(f"Public {label}: HTTP {actual}, expected {expected}")
    cli = shutil.which("paseo")
    if not cli:
        raise RuntimeError("The local Paseo CLI is required for WebSocket verification")
    env = {**os.environ, "PASEO_PASSWORD": password}
    p = subprocess.run([cli, "ls", "--host", f"tcp://{hostname}:443?ssl=true", "--json"],
                       env=env, capture_output=True, text=True, timeout=30)
    if p.returncode:
        raise RuntimeError("Authenticated public WebSocket connection failed")
    print(f"PASS {instance}: HTTPS web UI, public password enforcement and authenticated WebSocket connection")


if __name__ == "__main__":
    try:
        parser = argparse.ArgumentParser(description=__doc__)
        parser.add_argument("instance")
        parser.add_argument("--hostname")
        args = parser.parse_args()
        main(args.instance, args.hostname)
    except Exception as e:
        print("FAIL " + str(e), file=sys.stderr)
        sys.exit(1)
