#!/usr/bin/env python3
"""Offline regression checks for data volumes and deployment source identity.

Failures include missing/replaced volumes, foreign resources, engine outages and
shared implementation edits incorrectly passing as unchanged deployments.
"""
from copy import deepcopy
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import subprocess
import sys
import tempfile
from types import SimpleNamespace
import unittest
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader("paseo_manage", str(ROOT / "services/paseo/manage"))
spec = importlib.util.spec_from_loader(loader.name, loader)
m = importlib.util.module_from_spec(spec)
loader.exec_module(m)
INSTANCE = "family-a"


class StorageChecks(unittest.TestCase):
    def setUp(self):
        self.directory = tempfile.TemporaryDirectory(prefix="infra-storage-check-")
        self.addCleanup(self.directory.cleanup)
        root = Path(self.directory.name)
        self.addCleanup(patch.stopall)
        patch.object(m, "STATE", root / "state").start()
        patch.object(m, "CONFIG", root / "config").start()
        self.settings = {"port": 16770, "cpus": 2, "memory": "4g", "pids_limit": 512,
                         "image_ref": "fixture-image", "hostnames": [], "cors_origins": []}
        patch.object(m, "config", side_effect=lambda _: deepcopy(self.settings)).start()
        self.health = patch.object(m, "health").start()
        self.calls = []
        self.resources = {("image", "fixture-image"): {"Id": "fixture-image-id"}}
        for index, volume in enumerate(m.volumes(INSTANCE)):
            self.resources["volume", volume] = self.volume(volume, index)
        self.container = {"Id": "fixture-running-container", "Config": {"Labels": m.labels_for(INSTANCE)},
                          "State": {"Running": True, "Status": "running"},
                          "Mounts": [{"Type": "volume", "Name": v, "Destination": target}
                                     for v, target in m.volumes(INSTANCE).items()]}
        self.resources["container", m.name(INSTANCE)] = self.container
        patch.object(m, "engine", side_effect=self.engine).start()

    def volume(self, name, index):
        return {"Name": name, "Driver": "local", "CreatedAt": f"2026-01-01T00:00:0{index}Z",
                "Labels": m.labels_for(INSTANCE), "Mountpoint": "/fixture/" + name}

    def engine(self, *args, **kwargs):
        self.calls.append(args)
        kind, action = args[:2]
        key = kind, args[-1]
        if action == "inspect":
            if key in self.resources:
                return subprocess.CompletedProcess(args, 0, json.dumps([self.resources[key]]), "")
            return subprocess.CompletedProcess(args, 125, "", "no such resource")
        if action == "exists":
            return subprocess.CompletedProcess(args, 0 if key in self.resources else 1, "", "")
        if kind == "volume" and action == "create":
            self.assertNotIn(key, self.resources)
            self.resources[key] = self.volume(key[1], 9)
            return subprocess.CompletedProcess(args, 0, key[1], "")
        self.fail(f"Unexpected engine mutation: {args}")

    def assert_no_mutation(self):
        self.assertTrue(all(args[1] in ("inspect", "exists") for args in self.calls), self.calls)
        self.health.assert_not_called()

    def record(self):
        m.ensure_volumes(INSTANCE, self.container)
        self.calls.clear()

    def test_adoption_records_existing_identity_without_touching_container_or_volume(self):
        before = deepcopy(self.resources)
        m.ensure_volumes(INSTANCE, self.container)
        record = m.STATE / f"{INSTANCE}.volumes.json"
        self.assertEqual(record.stat().st_mode & 0o777, 0o600)
        self.assertEqual(m.STATE.stat().st_mode & 0o777, 0o700)
        self.assertEqual(self.resources, before)
        self.assert_no_mutation()

    def test_missing_registered_volumes_do_not_reappear_after_container_removal(self):
        self.record()
        self.resources.pop(("container", m.name(INSTANCE)))
        for volume in m.volumes(INSTANCE):
            self.resources.pop(("volume", volume))
        with self.assertRaisesRegex(RuntimeError, "missing data volumes"):
            m.deploy(INSTANCE)
        self.assert_no_mutation()
        self.assertFalse(m.password_file(INSTANCE).exists())

    def test_missing_single_volume_blocks_deploy_before_stopping_active_container(self):
        self.record()
        self.resources.pop(("volume", next(iter(m.volumes(INSTANCE)))))
        before = deepcopy(self.resources)
        with self.assertRaisesRegex(RuntimeError, "missing data volumes"):
            m.deploy(INSTANCE)
        self.assertEqual(self.resources, before)
        self.assert_no_mutation()

    def test_same_name_and_labels_do_not_hide_volume_recreation(self):
        self.record()
        volume = next(iter(m.volumes(INSTANCE)))
        self.resources["volume", volume]["CreatedAt"] = "2026-02-01T00:00:00Z"
        with self.assertRaisesRegex(RuntimeError, "identity changed"):
            m.deploy(INSTANCE)
        self.assert_no_mutation()

    def test_unchanged_deploy_cannot_skip_the_missing_volume_guard(self):
        self.record()
        secret = "fixture-password-0123456789"
        specification = {"config": self.settings, "image": "fixture-image-id", "password": secret,
                         "implementation": (ROOT / "services/paseo/manage").read_text()
                         + ("\n" + (ROOT / "podman.py").read_text() if (ROOT / "podman.py").exists() else "")}
        self.container["Config"]["Labels"]["infra.spec"] = m.hashlib.sha256(
            json.dumps(specification, sort_keys=True).encode()).hexdigest()
        self.resources.pop(("volume", next(iter(m.volumes(INSTANCE)))))
        with patch.object(m, "prepare_password", return_value=secret):
            with self.assertRaisesRegex(RuntimeError, "missing data volumes"):
                m.deploy(INSTANCE)
        self.assert_no_mutation()

    def test_existing_container_without_a_record_cannot_get_empty_replacements(self):
        self.resources.pop(("volume", next(iter(m.volumes(INSTANCE)))))
        with self.assertRaisesRegex(RuntimeError, "missing data volumes"):
            m.deploy(INSTANCE)
        self.assert_no_mutation()

    def test_partial_unregistered_environment_is_not_completed_with_an_empty_volume(self):
        self.resources.pop(("container", m.name(INSTANCE)))
        self.resources.pop(("volume", next(iter(m.volumes(INSTANCE)))))
        with self.assertRaisesRegex(RuntimeError, "missing data volumes"):
            m.deploy(INSTANCE)
        self.assert_no_mutation()

    def test_foreign_or_incorrectly_mounted_data_is_not_adopted(self):
        for wrong_mount in ("Name", "Destination", "Type"):
            container = deepcopy(self.container)
            container["Mounts"][0][wrong_mount] = "foreign"
            with self.assertRaisesRegex(RuntimeError, "mounts differ"):
                m.ensure_volumes(INSTANCE, container)
        volume = next(iter(m.volumes(INSTANCE)))
        self.resources["volume", volume]["Labels"]["infra.instance"] = "family-b"
        with self.assertRaisesRegex(RuntimeError, "not owned"):
            m.ensure_volumes(INSTANCE, self.container)
        self.assertFalse((m.STATE / f"{INSTANCE}.volumes.json").exists())
        self.assert_no_mutation()

    def test_corrupt_record_is_never_silently_repaired(self):
        self.record()
        record = m.STATE / f"{INSTANCE}.volumes.json"
        for content in ("{", "null", "{}", "[]"):
            record.write_text(content)
            with self.assertRaises((RuntimeError, ValueError)):
                m.deploy(INSTANCE)
            self.assertEqual(record.read_text(), content)
        self.assert_no_mutation()

    def test_engine_failure_is_not_treated_as_missing_volumes(self):
        unavailable = subprocess.CompletedProcess([], 125, "", "engine unavailable")
        with patch.object(m, "engine", return_value=unavailable) as engine:
            with self.assertRaisesRegex(RuntimeError, "engine unavailable"):
                m.ensure_volumes(INSTANCE, self.container, create=True)
        self.assertTrue(all(call.args[1] in ("inspect", "exists") for call in engine.call_args_list))

    def test_only_a_new_environment_can_create_empty_volumes(self):
        self.resources.pop(("container", m.name(INSTANCE)))
        for volume in m.volumes(INSTANCE):
            self.resources.pop(("volume", volume))
        m.ensure_volumes(INSTANCE, create=True)
        self.assertEqual(len([c for c in self.calls if c[:2] == ("volume", "create")]), 2)
        for volume in m.volumes(INSTANCE):
            self.resources.pop(("volume", volume))
        self.calls.clear()
        with self.assertRaisesRegex(RuntimeError, "missing data volumes"):
            m.ensure_volumes(INSTANCE, create=True)
        self.assert_no_mutation()

    def test_existing_credentials_prevent_reinitialization_if_the_record_is_lost(self):
        self.resources.pop(("container", m.name(INSTANCE)))
        for volume in m.volumes(INSTANCE):
            self.resources.pop(("volume", volume))
        secret = m.password_file(INSTANCE)
        secret.parent.mkdir(parents=True)
        secret.write_text("fixture-existing-password")
        with self.assertRaisesRegex(RuntimeError, "missing data volumes"):
            m.ensure_volumes(INSTANCE, create=True)
        self.assert_no_mutation()

    def test_container_replacement_keeps_registered_volume_identity(self):
        self.record()
        self.resources.pop(("container", m.name(INSTANCE)))
        record = m.STATE / f"{INSTANCE}.volumes.json"
        before = record.stat().st_ino, record.read_bytes()
        m.ensure_volumes(INSTANCE, create=True)
        self.assertEqual((record.stat().st_ino, record.read_bytes()), before)
        self.assert_no_mutation()

    def test_restart_checks_volume_identity_before_engine_restart(self):
        self.record()
        self.resources.pop(("volume", next(iter(m.volumes(INSTANCE)))))
        with patch.object(sys, "argv", ["manage", "restart", INSTANCE]):
            with self.assertRaisesRegex(RuntimeError, "missing data volumes"):
                m.main()
        self.assert_no_mutation()

    def test_shared_source_edit_requires_redeployment_with_the_same_data_volumes(self):
        self.record()
        manager = Path(self.directory.name) / "manage"
        shared = manager.with_name("podman.py")
        manager.write_text("fixture manager\n")
        shared.write_text("fixture shared runtime\n")
        secret = "fixture-password-0123456789"
        specification = {"config": self.settings, "image": "fixture-image-id", "password": secret,
                         "implementation": "fixture manager\n\nfixture shared runtime\n"}
        self.container["Config"]["Labels"]["infra.spec"] = m.hashlib.sha256(
            json.dumps(specification, sort_keys=True).encode()).hexdigest()
        helper = getattr(m, "podman", SimpleNamespace())
        with patch.object(m, "__file__", str(manager)), patch.object(m, "podman", helper, create=True), \
                patch.object(helper, "__file__", str(shared), create=True), \
                patch.object(m, "prepare_password", return_value=secret), \
                patch.object(m, "resource_setup", side_effect=RuntimeError("replacement required")) as replace:
            m.deploy(INSTANCE)
            replace.assert_not_called()
            shared.write_text("fixture shared runtime version two\n")
            with self.assertRaisesRegex(RuntimeError, "replacement required"):
                m.deploy(INSTANCE)
            replace.assert_called_once()
        self.assertTrue(all(call[1] in ("inspect", "exists") for call in self.calls))


if __name__ == "__main__":
    unittest.main()
