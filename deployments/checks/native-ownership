#!/usr/bin/env python3
"""Exercise native starts and cleanup with a disposable same-name collision.

Fails if systemd replaces/deletes a foreign container or cannot clean up its own.
Uses an existing image with /bin/sleep; touches only uniquely named fixtures.
"""
import json
import os
from pathlib import Path
import subprocess
import sys
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import podman
import quadlet


def check_native_lifecycle(image):
    service = "ownership-check-" + uuid.uuid4().hex[:12]
    name = "infra-" + service
    unit = name + ".service"
    root = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    target = root / f"containers/systemd/{name}.container"
    override = root / f"systemd/user/{unit}.d/20-infra-ownership.conf"
    systemd = ["systemctl", "--user"]
    config = {"image_ref": image, "container_name": name}
    try:
        podman.engine("create", "--name", name, *podman.label_args({"infra.check": service}),
                      "--network=none", "--read-only", "--image-volume=ignore", "--entrypoint=/bin/sleep", image, "300")
        original = podman.inspect(podman.engine, "container", name)["Id"]
        for path, content in [(target, quadlet.unit(service, config,
                               ["Network=none", "Entrypoint=/bin/sleep", "Exec=300"], [])),
                              (override, quadlet.cleanup_override(service, config))]:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
            path.chmod(0o600)
        subprocess.run(systemd + ["daemon-reload"], check=True)
        result = subprocess.run(systemd + ["start", unit], capture_output=True, timeout=30)
        assert result.returncode != 0, "Native start replaced the foreign fixture"
        assert podman.inspect(podman.engine, "container", name)["Id"] == original, "Failure cleanup deleted foreign fixture"
        podman.engine("rm", original)
        subprocess.run(systemd + ["reset-failed", unit], check=True)
        subprocess.run(systemd + ["start", unit], check=True, timeout=30)
        subprocess.run(systemd + ["stop", unit], check=True, timeout=30)
        assert podman.inspect(podman.engine, "container", name) is None, "Owned fixture was not cleaned up"
        print(json.dumps({"check": "native-ownership", "foreign_preserved": True, "owned_cleanup": True}))
    finally:
        subprocess.run(systemd + ["stop", unit], capture_output=True)
        podman.engine("rm", "-f", "--ignore", name, check=False)
        target.unlink(missing_ok=True)
        override.unlink(missing_ok=True)
        if override.parent.exists():
            override.parent.rmdir()
        subprocess.run(systemd + ["daemon-reload"], check=True)
        subprocess.run(systemd + ["reset-failed", unit], capture_output=True)


if __name__ == "__main__":
    check_native_lifecycle(sys.argv[1])
