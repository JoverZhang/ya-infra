#!/usr/bin/env python3
"""Manage the Telegram gateway without changing its CLI or notification plugin."""
import hashlib
from pathlib import Path
import stat
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
import podman
import quadlet


def definition(config):
    server = quadlet.path(config["server_config"])
    if not server.is_file() or stat.S_IMODE(server.stat().st_mode) & 0o077:
        raise ValueError("server_config must be an existing private file (0600)")
    volume = podman.inspect(podman.engine, "volume", config["data_volume"])
    if volume is None:
        raise ValueError("Existing TBG data volume is missing; restore it before deployment")
    database = Path(volume["Mountpoint"]) / "gateway.sqlite"
    if not database.is_file() or not database.stat().st_size:
        raise ValueError("Existing TBG database is missing; refusing to initialize empty data")
    options = ["Network=host", "Volume=" + quadlet.value(config["data_volume"] + ":/var/lib/tbg"),
               "Volume=" + quadlet.value(str(server) + ":/root/.config/tbg/server.yaml:ro"),
               "Label=infra.config=" + hashlib.sha256(server.read_bytes()).hexdigest()]
    return quadlet.unit("tbg", config, options,
                        [[*podman.ENGINE, "volume", "inspect", "--format={{.Name}}", config["data_volume"]],
                         ["/usr/bin/test", "-s", str(database)], ["/usr/bin/test", "-f", str(server)]])


def verify(config):
    # The unmodified gateway accepts POST requests and rejects GET with 405.
    podman.wait_http_ready(config["health_url"], 20, "TBG local probe failed", status=405)


if __name__ == "__main__":
    quadlet.report(lambda: quadlet.main("tbg", definition, verify))
