ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG NODE_MAJOR=24
ARG OPENCLI_VERSION
ENV DEBIAN_FRONTEND=noninteractive OPENCLI_WINDOW=foreground

RUN test -n "$OPENCLI_VERSION" \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg socat \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g "@jackwener/opencli@$OPENCLI_VERSION" \
    && npm cache clean --force \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i \
      -e '/mkdir -p \/run\/dbus/i chmod 0755 /run' \
      -e '/rm -f \/run\/dbus\/pid/a rm -f /run/dbus/system_bus_socket' \
      /etc/s6-overlay/s6-rc.d/svc-dbus/run \
    && grep -q 'chmod 0755 /run' /etc/s6-overlay/s6-rc.d/svc-dbus/run

COPY entrypoint.sh /usr/local/bin/browserlab-entrypoint
RUN chmod 0755 /usr/local/bin/browserlab-entrypoint
