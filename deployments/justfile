set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

[private]
[no-cd]
_build:
    @go -C {{quote(justfile_directory())}} build -o .bin/ya-infra .

[private]
[no-cd]
default: _build
    @exec {{quote(justfile_directory() / ".bin/ya-infra")}} --help

# Install pinned SOPS and age tools.
[no-cd]
bootstrap *args: _build
    @exec {{quote(justfile_directory() / ".bin/ya-infra")}} bootstrap "$@"

# Forward native Compose arguments; encrypted environment values stay in memory.
[no-cd]
compose app *args:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{quote(justfile_directory() / "apps")}}/"$1"
    shift
    export PODMAN_COMPOSE_PROVIDER=podman-compose
    if [[ -f config.sops.env ]]; then
        command="exec podman compose"
        for argument in "$@"; do
            command+=" '${argument//\'/\'\\\'\'}'"
        done
        exec sops exec-env --same-process config.sops.env "$command"
    fi
    exec podman compose "$@"

# Manage Cloudflare routes.
[no-cd]
gateway *args: _build
    @exec {{quote(justfile_directory() / ".bin/ya-infra")}} gateway "$@"
