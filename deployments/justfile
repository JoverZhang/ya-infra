set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

[private]
[no-cd]
_build:
    @go -C {{quote(justfile_directory())}} build -o .bin/ya-infra .

[private]
[no-cd]
default: _build
    @exec {{quote(justfile_directory() / ".bin/ya-infra")}} --help

# Install client tools and optional local cluster prerequisites.
[no-cd]
bootstrap *args: _build
    @exec {{quote(justfile_directory() / ".bin/ya-infra")}} bootstrap "$@"

# Forward native kubectl arguments.
[no-cd]
kubectl *args: _build
    @exec {{quote(justfile_directory() / ".bin/ya-infra")}} kubectl "$@"

# Manage Cloudflare routes.
[no-cd]
gateway *args: _build
    @exec {{quote(justfile_directory() / ".bin/ya-infra")}} gateway "$@"
