#!/usr/bin/env python3
"""Print one direct connection URI for a declared public Paseo environment."""
import argparse
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
from urllib.parse import urlencode

SERVICE = Path(__file__).resolve().parent
sys.path.insert(0, str(SERVICE.parents[1]))
from gateway.model import IDENTIFIER, hostnames_for, routes


def password(instance):
    config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    password_file = config / "infra/paseo" / instance / "password"
    if not password_file.is_file():
        raise ValueError("缺少密码文件；请先部署该环境")
    if stat.S_IMODE(password_file.stat().st_mode) & 0o077:
        raise ValueError("密码文件需要私有权限 0600")
    value = password_file.read_text().strip()
    if len(value) < 24 or not re.fullmatch(r"[a-zA-Z0-9_-]+", value):
        raise ValueError("密码文件格式无效")
    return value


def runtime_states():
    engine = ["podman", "--remote", "--url", f"unix:///run/user/{os.getuid()}/podman/podman.sock"]
    try:
        result = subprocess.run(engine + ["ps", "--all", "--filter", "label=infra.managed=true",
                                "--filter", "label=infra.service=paseo",
                                "--filter", f"label=infra.owner={os.getuid()}", "--format", "json"],
                                capture_output=True, text=True, timeout=5, check=True)
        containers = json.loads(result.stdout)
        labels = {"running": "运行中", "exited": "已停止", "stopped": "已停止",
                  "created": "已创建", "paused": "已暂停"}
        return {item["Labels"]["infra.instance"]: labels.get(item.get("State"), "状态未知")
                for item in containers if item.get("Labels", {}).get("infra.instance")}
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return None


def available_targets(instance=None):
    paths = sorted((SERVICE / "instances").glob("*.toml"))
    if instance is not None:
        if not re.fullmatch(IDENTIFIER, instance) or not any(path.stem == instance for path in paths):
            raise ValueError("未知 Paseo 环境；运行 just svc paseo pair --list 查看环境")
        paths = [path for path in paths if path.stem == instance]
    declared = routes()
    states = runtime_states()
    targets, unavailable = [], []
    for path in paths:
        name = path.stem
        if not re.fullmatch(IDENTIFIER, name):
            unavailable.append((name, "环境名称无效"))
            continue
        hosts = sorted(route.hostname for route in declared if route.backend == "paseo/" + name)
        if not hosts:
            unavailable.append((name, "缺少公网 Route"))
            continue
        try:
            password(name)
        except ValueError as error:
            unavailable.append((name, str(error)))
            continue
        except OSError:
            unavailable.append((name, "密码文件不可读"))
            continue
        state = states.get(name, "未部署") if states is not None else "状态未知"
        targets.extend({"instance": name, "hostname": host, "state": state} for host in hosts)
    return targets, unavailable


def show_targets(targets, unavailable, stream):
    print("可生成配对链接的 Paseo 环境：", file=stream)
    for number, target in enumerate(targets, 1):
        print(f"  {number}) {target['instance']:16} {target['hostname']:30} {target['state']}", file=stream)
    if not targets:
        print("  暂无可配对环境", file=stream)
    if unavailable:
        print("\n尚不能生成链接：", file=stream)
        for name, reason in unavailable:
            print(f"  {name}: {reason}", file=stream)


def choose_target(targets):
    while True:
        default = " [Enter 选择唯一环境]" if len(targets) == 1 else ""
        print(f"\n选择编号或环境名{default}（q 取消）：", end="", file=sys.stderr, flush=True)
        answer = sys.stdin.readline()
        if not answer or answer.strip().lower() in ("q", "quit"):
            print("已取消", file=sys.stderr)
            return None
        answer = answer.strip()
        if not answer and len(targets) == 1:
            return targets[0]
        if answer.isdecimal() and 1 <= int(answer) <= len(targets):
            return targets[int(answer) - 1]
        matched = [target for target in targets if target["instance"] == answer]
        if len(matched) == 1:
            return matched[0]
        message = "该环境有多个域名，请选择编号" if matched else "请输入菜单中的编号或环境名"
        print(message, file=sys.stderr)


def pairing_link(instance, hostname=None):
    if not re.fullmatch(IDENTIFIER, instance):
        raise ValueError("Use a valid Paseo instance name")
    if not (SERVICE / "instances" / (instance + ".toml")).is_file():
        raise ValueError("Unknown Paseo instance: " + instance)
    hosts = hostnames_for("paseo/" + instance)
    if hostname:
        if hostname not in hosts:
            raise ValueError("Hostname is not declared for this Paseo instance")
    elif len(hosts) == 1:
        hostname = hosts[0]
    else:
        raise ValueError("Declare one public Route for this instance, or select its hostname explicitly")
    return "tcp://" + hostname + ":443?" + urlencode({"ssl": "true", "password": password(instance)})


def main():
    parser = argparse.ArgumentParser(prog="just svc paseo pair", description=__doc__)
    parser.add_argument("instance", nargs="?", help="环境名；省略则选择环境")
    parser.add_argument("--hostname", help="选择该环境的一个已声明公网域名")
    parser.add_argument("--list", action="store_true", help="只列环境信息，不输出密码或链接")
    args = parser.parse_args()
    if args.hostname and not args.instance:
        parser.error("--hostname 需要指定环境名")
    if args.instance and not args.list:
        if args.hostname or len(hostnames_for("paseo/" + args.instance)) == 1:
            print(pairing_link(args.instance, args.hostname))
            return 0
    targets, unavailable = available_targets(args.instance)
    if args.hostname:
        targets = [target for target in targets if target["hostname"] == args.hostname]
        if not targets:
            raise ValueError("该域名不是此环境的可配对公网域名")
    show_targets(targets, unavailable, sys.stdout if args.list else sys.stderr)
    if args.list:
        return 0
    if not targets:
        print("请先配置公网 Route 并部署环境。用法：just svc paseo deploy <环境>", file=sys.stderr)
        return 2
    if not sys.stdin.isatty():
        print("非交互运行请指定环境：just svc paseo pair <环境> [--hostname <域名>]", file=sys.stderr)
        return 2
    target = choose_target(targets)
    if target is not None:
        print(pairing_link(target["instance"], target["hostname"]))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError) as error:
        print("error: " + str(error), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("\n已取消", file=sys.stderr)
        sys.exit(130)
