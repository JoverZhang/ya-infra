ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
COPY artifacts/node /usr/local/bin/node
COPY artifacts/codex-dist /usr/local/
COPY artifacts/paseo /usr/local/lib/node_modules/@getpaseo/cli
RUN chmod 755 /usr/local/bin/node /usr/local/bin/codex /usr/local/bin/codex-code-mode-host \
    && ln -s /usr/local/lib/node_modules/@getpaseo/cli/bin/paseo /usr/local/bin/paseo \
    && node --version && codex --version && paseo --version \
    && test -x /usr/local/bin/codex-code-mode-host \
    && test -f /usr/local/lib/node_modules/@getpaseo/cli/node_modules/@getpaseo/server/dist/scripts/supervisor-entrypoint.js \
    && mkdir -p /home/paseo/.codex /home/paseo/.paseo /workspace \
    && chown -R 1000:1000 /home/paseo /workspace

ENV HOME=/home/paseo \
    PASEO_HOME=/home/paseo/.paseo \
    PASEO_LISTEN=0.0.0.0:6767 \
    PASEO_WEB_UI_ENABLED=true \
    PASEO_LOG_FORMAT=json \
    PASEO_LOG_LEVEL=info \
    CODEX_HOME=/home/paseo/.codex \
    XDG_CONFIG_HOME=/home/paseo/.config \
    XDG_DATA_HOME=/home/paseo/.local/share \
    XDG_STATE_HOME=/home/paseo/.local/state \
    XDG_CACHE_HOME=/home/paseo/.cache

COPY codex.toml /opt/infra/codex.toml
COPY initialize.sh /opt/infra/initialize.sh
RUN chmod 755 /opt/infra/initialize.sh

# Volumes are initialized separately; the long-running daemon has no root phase.
USER 1000:1000
RUN node --version && codex --version && paseo --version && test -x /usr/local/bin/codex-code-mode-host
WORKDIR /workspace
EXPOSE 6767
ENTRYPOINT ["node", "/usr/local/lib/node_modules/@getpaseo/cli/node_modules/@getpaseo/server/dist/scripts/supervisor-entrypoint.js"]
