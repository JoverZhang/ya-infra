#!/usr/bin/env python3
"""Manage the existing remotely configured Cloudflare Tunnel connector."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import time
import tomllib
import urllib.error
import urllib.request

SERVICE = Path(__file__).resolve().parent
ENGINE = ["podman", "--remote", "--url", f"unix:///run/user/{os.getuid()}/podman/podman.sock"]
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "infra/cloudflare-tunnel"
STATE = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "infra/cloudflare-tunnel"
NAME = "infra-cloudflare-tunnel"
LABELS = {"infra.managed": "true", "infra.service": "cloudflare-tunnel", "infra.owner": str(os.getuid())}


def engine(*args, capture=True, check=True, input=None):
    return subprocess.run(ENGINE + list(args), text=True, input=input, capture_output=capture, check=check)


def inspect(kind, name):
    p = engine(kind, "inspect", name, check=False)
    if p.returncode:
        exists = engine(kind, "exists", name, check=False)
        if exists.returncode == 1:
            return None
        raise RuntimeError(p.stderr.strip() or f"Cannot inspect {kind} {name}")
    return json.loads(p.stdout)[0]


def private_directory(path):
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)


def owned(data):
    labels = data.get("Config", {}).get("Labels") or data.get("Spec", {}).get("Labels") or {}
    if not all(labels.get(k) == v for k, v in LABELS.items()):
        raise RuntimeError("Refusing to modify a resource not owned by infra/cloudflare-tunnel")


def label_args():
    return [arg for pair in LABELS.items() for arg in ("--label", "=".join(pair))]


def settings():
    with (SERVICE / "versions.toml").open("rb") as f:
        c = tomllib.load(f)
    with (SERVICE / "config.toml").open("rb") as f:
        c.update(tomllib.load(f))
    if not re.fullmatch(r"docker.io/cloudflare/cloudflared@sha256:[0-9a-f]{64}", c["image_ref"]):
        raise ValueError("cloudflared image must be pinned by digest")
    if type(c["metrics_port"]) is not int or not 1024 <= c["metrics_port"] <= 65535:
        raise ValueError("metrics_port must be an integer between 1024 and 65535")
    if not re.fullmatch(r"[1-9][0-9]*[mg]", c["memory"]):
        raise ValueError("memory must use a positive m/g value")
    if type(c["cpus"]) not in (int, float) or not 0 < c["cpus"] <= 32:
        raise ValueError("cpus must be positive and at most 32")
    if type(c["pids_limit"]) is not int or not 64 <= c["pids_limit"] <= 4096:
        raise ValueError("pids_limit must be between 64 and 4096")
    return c


def adopt(legacy_name):
    """Recover the already authorized connector token without emitting it."""
    d = inspect("container", legacy_name)
    if not d or d["HostConfig"]["NetworkMode"] != "host" or d.get("Mounts"):
        raise RuntimeError("Expected the existing host-network connector without mounts")
    if d["Config"].get("Labels", {}).get("org.opencontainers.image.source") != "https://github.com/cloudflare/cloudflared":
        raise RuntimeError("Expected the official cloudflared container")
    cmd = d["Config"].get("Cmd") or []
    if len(cmd) != 5 or cmd[:4] != ["tunnel", "--no-autoupdate", "run", "--token"]:
        raise RuntimeError("Legacy command differs from the inspected token-based deployment")
    token = cmd[4].strip()
    if len(token) < 64 or not re.fullmatch(r"[A-Za-z0-9_+/=-]+", token):
        raise RuntimeError("Unexpected legacy token format")
    private_directory(CONFIG)
    p = CONFIG / "token"
    if p.exists():
        if p.read_text().strip() != token:
            raise RuntimeError("A different token already exists; resolve the credential source first")
    else:
        with os.fdopen(os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            f.write(token + "\n")
    p.chmod(0o600)
    record = {"name": legacy_name, "id": d["Id"], "image": d["Image"]}
    legacy_file = STATE / "legacy.json"
    if legacy_file.exists() and json.loads(legacy_file.read_text()) != record:
        raise RuntimeError("A different legacy connector is already recorded")
    legacy_file.write_text(json.dumps(record, indent=2) + "\n")
    print(f"Imported connector credential to {p}; the existing connector is still running")


def secret(token):
    digest = hashlib.sha256(token.encode()).hexdigest()
    name = NAME + "-token-" + digest[:16]
    p = engine("secret", "inspect", name, check=False)
    if p.returncode:
        engine("secret", "create", *label_args(), "--label", "infra.token.sha256=" + digest, name, "-", input=token)
    else:
        data = json.loads(p.stdout)[0]
        owned(data)
        if data["Spec"]["Labels"].get("infra.token.sha256") != digest:
            raise RuntimeError("The named Podman secret has different credential metadata")
    return name, digest


def health(c, timeout=60):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{c['metrics_port']}/ready", timeout=2) as r:
                if r.status == 200:
                    return
        except (urllib.error.URLError, TimeoutError, ConnectionError):
            pass
        time.sleep(1)
    raise RuntimeError("Cloudflare edge readiness timed out; inspect 'just svc cloudflare-tunnel logs'")


def retire_legacy():
    p = STATE / "legacy.json"
    if not p.is_file():
        return
    record = json.loads(p.read_text())
    d = inspect("container", record["name"])
    if not d:
        return
    if d["Id"] != record["id"]:
        raise RuntimeError("The legacy container was replaced; refusing to stop it")
    if d["State"]["Running"]:
        engine("stop", record["name"])
        print(f"Stopped {record['name']}; retained the container for rollback")


def deploy():
    c = settings()
    image = inspect("image", c["image_ref"])
    if not image:
        raise RuntimeError("Pinned image missing. Run 'just svc cloudflare-tunnel build' first")
    token = (CONFIG / "token").read_text().strip()
    secret_name, token_hash = secret(token)
    spec = hashlib.sha256(json.dumps({"config": c, "image": image["Id"], "token": token_hash,
                                     "implementation": Path(__file__).read_text()}, sort_keys=True).encode()).hexdigest()
    current = inspect("container", NAME)
    if current:
        owned(current)
        if current["Config"]["Labels"].get("infra.spec") == spec:
            if not current["State"]["Running"]:
                engine("start", NAME)
            health(c)
            retire_legacy()
            print("cloudflare-tunnel: unchanged, connected")
            return
    else:
        with socket.socket() as sock:
            try:
                sock.bind(("127.0.0.1", c["metrics_port"]))
            except OSError as e:
                raise RuntimeError("The configured loopback metrics port is occupied") from e
    old = None
    old_running = False
    try:
        if current:
            old = NAME + "-previous-" + str(time.time_ns())
            old_running = current["State"]["Running"]
            engine("stop", NAME)
            engine("rename", NAME, old)
        engine("run", "-d", "--pull=never", "--name", NAME, *label_args(), "--label", "infra.spec=" + spec,
               "--restart=always", "--user=65532:65532", "--read-only", "--cap-drop=all",
               "--security-opt=no-new-privileges", "--network=host", "--http-proxy=false",
               "--cpus", str(c["cpus"]), "--memory", c["memory"], "--memory-swap", c["memory"],
               "--pids-limit", str(c["pids_limit"]), "--tmpfs", "/tmp:rw,nosuid,nodev,size=32m,mode=1777",
               "--secret", secret_name + ",target=tunnel-token,uid=65532,gid=65532,mode=0400",
               c["image_ref"], "tunnel", "--metrics", f"127.0.0.1:{c['metrics_port']}",
               "run", "--token-file", "/run/secrets/tunnel-token")
        health(c)
    except Exception:
        failed = inspect("container", NAME)
        if failed and old:
            owned(failed)
            engine("rm", "-f", NAME)
        if old:
            engine("rename", old, NAME)
            if old_running:
                engine("start", NAME)
        raise
    if old:
        engine("rm", old)
    retire_legacy()
    print("cloudflare-tunnel: connected; remote routes preserved")


def require_container():
    d = inspect("container", NAME)
    if not d:
        raise RuntimeError("cloudflare-tunnel: not deployed")
    owned(d)
    return d


def verify():
    c = settings()
    d = require_container()
    h = d["HostConfig"]
    assert d["State"]["Running"], "container must be running"
    assert d["Config"]["User"] == "65532:65532", "non-root user required"
    assert h["ReadonlyRootfs"] and not h["Privileged"], "read-only unprivileged runtime required"
    # Podman expands 'all' into a list, so verify the live process rather than
    # relying on the spelling of the creation flag in inspect metadata.
    fields = dict(line.split(":", 1) for line in Path(f"/proc/{d['State']['Pid']}/status").read_text().splitlines() if ":" in line)
    assert int(fields["CapEff"].strip(), 16) == 0 and int(fields["CapBnd"].strip(), 16) == 0, "zero capabilities required"
    assert fields["NoNewPrivs"].strip() == "1", "no-new-privileges required"
    assert h["NetworkMode"] == "host", "host networking preserves loopback origins"
    assert h["RestartPolicy"]["Name"] == "always", "boot restart policy required"
    expected_memory = int(c["memory"][:-1]) * 1024 ** (3 if c["memory"][-1] == "g" else 2)
    assert h["Memory"] == expected_memory and h["PidsLimit"] == c["pids_limit"], "resource limits required"
    cmd = d["Config"]["Cmd"]
    assert "--token-file" in cmd and "--token" not in cmd, "token must not appear in process arguments"
    assert not any(x.startswith("TUNNEL_TOKEN=") for x in d["Config"]["Env"]), "token must not appear in environment"
    secrets = d["Config"].get("Secrets", [])
    assert len(secrets) == 1 and secrets[0]["UID"] == 65532 and secrets[0]["GID"] == 65532 and secrets[0]["Mode"] == 0o400, "private non-root secret mount required"
    assert f"127.0.0.1:{c['metrics_port']}" in cmd, "metrics must bind to loopback"
    health(c, timeout=10)
    before = d["Id"]
    deploy()
    assert require_container()["Id"] == before, "unchanged deployment must be a no-op"
    print("PASS edge ready, non-root read-only runtime, loopback metrics, secret-file credential, unchanged deploy")


def main():
    parser = argparse.ArgumentParser(prog="just svc cloudflare-tunnel", description=__doc__)
    parser.add_argument("command", nargs="?", choices=["adopt", "build", "deploy", "status", "logs", "stop", "restart", "verify"])
    parser.add_argument("legacy_name", nargs="?")
    args = parser.parse_args()
    if args.command is None:
        parser.print_help()
        return
    os.umask(0o077)
    private_directory(STATE)
    with (STATE / "manage.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.command == "adopt":
            adopt(args.legacy_name or "cloudflare-tunnel")
        elif args.legacy_name:
            parser.error("only adopt accepts a legacy container name")
        elif args.command == "build":
            c = settings()
            if not inspect("image", c["image_ref"]):
                engine("pull", c["image_ref"], capture=False)
            print("Pinned cloudflared image is available")
        elif args.command == "deploy":
            deploy()
        elif args.command == "status":
            d = inspect("container", NAME)
            if d:
                owned(d)
                print("cloudflare-tunnel:", d["State"]["Status"])
                if d["State"]["Running"]:
                    health(settings(), timeout=3)
                    print("Cloudflare edge: ready")
            else:
                print("cloudflare-tunnel: not deployed")
        elif args.command == "verify":
            verify()
        else:
            require_container()
            if args.command == "logs":
                engine("logs", "--tail=100", NAME, capture=False)
            else:
                engine(args.command, NAME)
                if args.command == "restart":
                    health(settings())


if __name__ == "__main__":
    try:
        main()
    except (AssertionError, ValueError, RuntimeError, FileNotFoundError, subprocess.CalledProcessError) as e:
        print("error: " + (getattr(e, "stderr", None) or str(e)).strip(), file=sys.stderr)
        sys.exit(1)
