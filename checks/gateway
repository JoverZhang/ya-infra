#!/usr/bin/env python3
"""Offline checks for route conflicts, preservation, drift and partial publication."""
from copy import deepcopy
from contextlib import redirect_stdout
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import sys
import tempfile
import unittest
import urllib.error
from unittest.mock import MagicMock, Mock, patch

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from gateway import model
from gateway.cloudflare import APIError, Client, MissingCredentials, api_token
from gateway.diagnostics import check_credentials
from gateway.controller import Conflict, Controller, State

ROUTE = model.Route("paseo1", "public", "paseo1.example.org", "paseo/demo")
ENDPOINT = {"url": "http://127.0.0.1:16770", "health_path": "/api/health"}
GATEWAY = {"provider": "cloudflare-tunnel", "zone": "example.org",
           "account_id": "a" * 32, "tunnel_id": "00000000-0000-0000-0000-000000000001"}
ORIGINAL = {"originRequest": {"connectTimeout": 17}, "warp-routing": {"enabled": False},
            "ingress": [
                {"hostname": "privateapi.example.org", "service": "http://127.0.0.1:28080",
                 "originRequest": {"httpHostHeader": "privateapi"}},
                {"hostname": "cpe.example.org", "service": "http://localhost:27310"},
                {"hostname": "*.example.org", "service": "http://localhost:9000"},
                {"service": "http_status:404"}]}


class Cloud:
    def __init__(self):
        self.gateway = GATEWAY
        self.config = deepcopy(ORIGINAL)
        self.version = 8
        self.dns = []
        self.writes = []
        self.fail_dns = False

    def configuration(self):
        return {"source": "cloudflare", "version": self.version, "config": deepcopy(self.config)}

    def records(self, hostname):
        return deepcopy(self.dns)

    def update_configuration(self, config):
        self.config = deepcopy(config)
        self.version += 1
        self.writes.append("ingress")

    def create_record(self, hostname):
        if self.fail_dns:
            raise RuntimeError("DNS unavailable")
        self.dns = [{"id": "dns-1", "type": "CNAME", "name": hostname,
                     "content": GATEWAY["tunnel_id"] + ".cfargotunnel.com", "proxied": True}]
        self.writes.append("dns")
        return deepcopy(self.dns[0])


class ControllerChecks(unittest.TestCase):
    def setUp(self):
        self.directory = tempfile.TemporaryDirectory()
        self.addCleanup(self.directory.cleanup)
        self.state = State(Path(self.directory.name) / "state")
        self.cloud = Cloud()
        self.calls = []
        self.after_deploy = lambda: None
        self.fail_verify = False
        self.health = patch("gateway.controller.healthy", return_value=True).start()
        self.addCleanup(patch.stopall)
        self.controller = Controller(self.cloud, self.state, resolve=lambda r: ENDPOINT, backend=self.backend)

    def backend(self, route, command, *args):
        self.calls.append((command, args))
        if command == "deploy":
            self.after_deploy()
        if command == "verify-public" and self.fail_verify:
            raise RuntimeError("Public WebSocket unavailable")

    def test_plan_is_read_only_and_preserves_all_other_rules(self):
        plan = self.controller.plan(ROUTE)
        self.assertEqual(plan["config"]["ingress"][1:], ORIGINAL["ingress"])
        self.assertEqual(plan["config"]["originRequest"], ORIGINAL["originRequest"])
        self.assertEqual(plan["config"]["warp-routing"], ORIGINAL["warp-routing"])
        self.assertEqual(self.cloud.config, ORIGINAL)
        self.assertFalse(self.calls or self.cloud.writes or self.state.read())

    def test_apply_is_idempotent_and_requires_public_verification(self):
        self.controller.apply(ROUTE)
        self.controller.apply(ROUTE)
        self.assertEqual(self.cloud.writes, ["ingress", "dns"])
        self.assertEqual(self.cloud.config["ingress"][1:], ORIGINAL["ingress"])
        self.assertEqual(self.state.read()[ROUTE.hostname]["phase"], "verified")
        self.assertIn(("verify-public", ("--hostname", ROUTE.hostname)), self.calls)
        self.assertEqual((self.state.directory / "routes.json").stat().st_mode & 0o777, 0o600)

    def test_dns_conflict_precedes_backend_deployment(self):
        self.cloud.dns = [{"type": "A", "content": "192.0.2.1", "proxied": True}]
        with self.assertRaises(Conflict):
            self.controller.apply(ROUTE)
        self.assertFalse(self.calls or self.cloud.writes)

    def test_foreign_origin_is_not_overwritten(self):
        self.cloud.config["ingress"].insert(0, {"hostname": ROUTE.hostname, "service": "http://localhost:99"})
        with self.assertRaises(Conflict):
            self.controller.apply(ROUTE)
        self.assertFalse(self.calls or self.cloud.writes)

    def test_owned_origin_change_preserves_rule_options(self):
        self.cloud.config["ingress"].insert(0, {"hostname": ROUTE.hostname, "service": "http://localhost:99",
                                               "originRequest": {"noTLSVerify": True}})
        self.state.write({ROUTE.hostname: {"gateway": "public", "origin": "http://localhost:99"}})
        self.controller.apply(ROUTE)
        self.assertEqual(self.cloud.config["ingress"][0]["service"], ENDPOINT["url"])
        self.assertEqual(self.cloud.config["ingress"][0]["originRequest"], {"noTLSVerify": True})

    def test_path_rule_is_not_replaced_by_whole_hostname(self):
        self.cloud.config["ingress"].insert(0, {"hostname": ROUTE.hostname, "path": "^/api", "service": ENDPOINT["url"]})
        with self.assertRaises(Conflict):
            self.controller.apply(ROUTE)
        self.assertFalse(self.cloud.writes or self.calls)

    def test_config_drift_during_deploy_stops_cloud_writes(self):
        def drift():
            self.cloud.config["originRequest"]["connectTimeout"] = 20
        self.after_deploy = drift
        with self.assertRaises(Conflict):
            self.controller.apply(ROUTE)
        self.assertFalse(self.cloud.writes)
        self.assertEqual(self.cloud.config["originRequest"]["connectTimeout"], 20)

    def test_dns_drift_during_deploy_stops_cloud_writes(self):
        self.after_deploy = lambda: self.cloud.dns.append({"type": "TXT", "content": "another admin"})
        with self.assertRaises(Conflict):
            self.controller.apply(ROUTE)
        self.assertFalse(self.cloud.writes)

    def test_unhealthy_backend_stops_cloud_writes(self):
        self.health.return_value = False
        with self.assertRaises(RuntimeError):
            self.controller.apply(ROUTE)
        self.assertFalse(self.cloud.writes or self.state.read())

    def test_dns_failure_leaves_retryable_partial_state(self):
        self.cloud.fail_dns = True
        with self.assertRaises(RuntimeError):
            self.controller.apply(ROUTE)
        self.assertEqual(self.state.read()[ROUTE.hostname]["phase"], "dns-pending")
        self.assertEqual(self.cloud.writes, ["ingress"])
        self.assertEqual(json.loads((self.state.directory / "before-last-apply.json").read_text())["config"], ORIGINAL)
        with self.assertRaises(RuntimeError):
            self.controller.apply(ROUTE)
        self.assertEqual(self.state.read()[ROUTE.hostname]["phase"], "dns-pending")
        self.cloud.fail_dns = False
        self.controller.apply(ROUTE)
        self.assertEqual(self.cloud.writes, ["ingress", "dns"])
        self.assertEqual(self.state.read()[ROUTE.hostname]["phase"], "verified")

    def test_public_failure_never_claims_verified(self):
        self.fail_verify = True
        with self.assertRaises(RuntimeError):
            self.controller.apply(ROUTE)
        self.assertEqual(self.state.read()[ROUTE.hostname]["phase"], "published")
        self.fail_verify = False
        self.controller.verify(ROUTE)
        self.assertEqual(self.state.read()[ROUTE.hostname]["phase"], "verified")


class DeclarationChecks(unittest.TestCase):
    def test_service_origins_only_include_its_declared_https_routes(self):
        self.write_route("web", "paseo.example.org", "paseo-web/main")
        self.write_route("paseo1", "paseo1.example.org", "paseo/demo")
        self.assertEqual(model.origins_for_service("paseo-web", self.root), ["https://paseo.example.org"])
        self.assertEqual(model.origins_for_service("absent", self.root), [])

    def setUp(self):
        self.directory = tempfile.TemporaryDirectory()
        self.addCleanup(self.directory.cleanup)
        self.root = Path(self.directory.name)
        self.declarations = {}
        self.write_route("paseo1", ROUTE.hostname)

    def write_route(self, name, hostname, backend="paseo/demo"):
        self.declarations[name] = {"gateway": "public", "hostname": hostname, "backend": backend}
        lines = ["[gateway.public]", *(f'{key} = {json.dumps(value)}' for key, value in GATEWAY.items())]
        for route_name, route in self.declarations.items():
            lines.extend(["", f"[gateway.routes.{route_name}]",
                          *(f'{key} = {json.dumps(value)}' for key, value in route.items())])
        (self.root / "infra.toml").write_text("\n".join(lines) + "\n")

    def test_two_hostnames_for_same_backend_are_derived(self):
        self.write_route("paseo2", "paseo2.example.org")
        self.assertEqual(model.hostnames_for("paseo/demo", self.root), [ROUTE.hostname, "paseo2.example.org"])
        self.assertEqual(model.hostnames_for("paseo/other", self.root), [])

    def test_duplicate_hostname_is_rejected(self):
        self.write_route("paseo2", ROUTE.hostname)
        with self.assertRaises(ValueError):
            model.routes(self.root)

    def test_outside_zone_and_invalid_backend_are_rejected(self):
        for hostname, backend in [("example.org.evil.org", "paseo/demo"), (ROUTE.hostname, "../demo")]:
            with self.subTest(hostname=hostname, backend=backend):
                self.write_route("paseo1", hostname, backend)
                with self.assertRaises(ValueError):
                    model.routes(self.root)

    def test_management_credential_must_be_present_and_private(self):
        with patch.dict(os.environ, {"XDG_CONFIG_HOME": self.directory.name}, clear=True):
            with self.assertRaises(MissingCredentials):
                api_token()
            p = self.root / "infra/gateway/public/credentials.env"
            p.parent.mkdir(parents=True)
            p.write_text("CLOUDFLARE_API_TOKEN=" + "test-only-credential-value" + "\n")
            p.chmod(0o644)
            with self.assertRaises(ValueError):
                api_token()
            p.chmod(0o600)
            self.assertEqual(api_token(), "test-only-credential-value")


class SharedWebTransportChecks(unittest.TestCase):
    def verifier(self):
        loader = importlib.machinery.SourceFileLoader("paseo_web_public_checks", str(ROOT / "checks/paseo-web-public"))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        return module

    def test_transient_https_failure_does_not_prevent_public_verification(self):
        verifier = self.verifier()
        response = MagicMock()
        response.__enter__.return_value = response
        response.code = 200
        response.headers = {}
        response.read.return_value = b"paseo"
        opener = Mock()
        opener.open.side_effect = [urllib.error.URLError("TLS handshake interrupted"), response]
        with patch.object(verifier.urllib.request, "build_opener", return_value=opener), patch("time.sleep"):
            self.assertEqual(verifier.request("paseo.example.org", "/")[0], 200)

    def test_wrong_password_response_is_not_retried_as_a_transport_error(self):
        verifier = self.verifier()
        failure = urllib.error.HTTPError("https://paseo1.example.org/api/status", 401,
                                         "Unauthorized", {}, io.BytesIO(b"unauthorized"))
        opener = Mock()
        opener.open.side_effect = failure
        with patch.object(verifier.urllib.request, "build_opener", return_value=opener):
            self.assertEqual(verifier.request("paseo1.example.org", "/api/status", password="wrong")[0], 401)
        opener.open.assert_called_once()


class CredentialDiagnosticsChecks(unittest.TestCase):
    def test_apply_publishes_environments_before_shared_ui(self):
        loader = importlib.machinery.SourceFileLoader("gateway_manage_order_checks", str(ROOT / "gateway/manage"))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        manage = importlib.util.module_from_spec(spec)
        loader.exec_module(manage)
        web = model.Route("paseo-web", "public", "paseo.example.org", "paseo-web/main")
        controller = Mock()
        with tempfile.TemporaryDirectory() as directory, \
                patch.object(manage, "STATE", Path(directory)), \
                patch.object(manage, "Client", return_value=Mock()), \
                patch.object(manage, "Controller", return_value=controller), \
                patch.object(manage.model, "select", return_value=[web, ROUTE]), \
                patch.object(manage.model, "endpoint", return_value=ENDPOINT), \
                patch.object(sys, "argv", ["gateway/manage", "apply"]), redirect_stdout(io.StringIO()):
            manage.main()
        self.assertEqual([call.args[0] for call in controller.apply.call_args_list], [ROUTE, web])

    def test_provider_ip_restriction_is_not_reported_as_missing_zone_permission(self):
        for address, cidr in [("192.0.2.10", "192.0.2.10/32"), ("2001:db8::10", "2001:db8::10/128")]:
            with self.subTest(address=address):
                client = Client(GATEWAY, token="test-only-credential-value")
                payload = json.dumps({"errors": [{"code": 9109,
                    "message": "Cannot use the access token from location: " + address}]}).encode()
                client.opener = Mock()
                client.opener.open.side_effect = urllib.error.HTTPError(
                    "https://api.cloudflare.com/client/v4/zones", 403, "Forbidden", {}, io.BytesIO(payload))
                with self.assertRaises(RuntimeError) as error:
                    client.zone_id()
                message = str(error.exception)
                self.assertIn(cidr, message)
                self.assertIn("IP", message)
                self.assertNotIn("Zone → Zone → Read", message)

    def test_ip_restriction_prefix_with_invalid_address_cannot_echo_secret(self):
        token = "test-only-credential-value"
        for candidate in [token, "fe80::1%" + token]:
            with self.subTest(candidate=candidate):
                client = Client(GATEWAY, token=token)
                payload = json.dumps({"errors": [{"code": 9109,
                    "message": "Cannot use the access token from location: " + candidate}]}).encode()
                client.opener = Mock()
                client.opener.open.side_effect = urllib.error.HTTPError(
                    "https://api.cloudflare.com/client/v4/zones", 403, "Forbidden", {}, io.BytesIO(payload))
                with self.assertRaises(RuntimeError) as error:
                    client.zone_id()
                self.assertNotIn(token, str(error.exception))
                self.assertNotIn("Zone → Zone → Read", str(error.exception))

    def test_ip_blocked_diagnostics_do_not_claim_missing_zone_permissions(self):
        client = Mock()
        client.verify_token.return_value = {"status": "active"}
        client.zone_id.side_effect = APIError("GET", "/zones", 403, [9109], reason="client_ip")
        client.configuration.return_value = {"config": ORIGINAL}
        messages = []
        with self.assertRaisesRegex(RuntimeError, "blocked by token Client IP Address Filtering"):
            check_credentials(client, [ROUTE], emit=messages.append)
        self.assertTrue(any(x.startswith("BLOCKED Zone / Zone / Read") for x in messages))
        self.assertFalse(any(x.startswith("FAIL Zone / Zone / Read") for x in messages))
        self.assertNotIn("fix Zone / Zone / Read", "\n".join(messages))
        client.configuration.assert_called_once()
        client.create_record.assert_not_called()
        client.update_configuration.assert_not_called()

    def test_zone_denial_identifies_endpoint_permission_and_resource_without_secrets(self):
        token = "test-only-credential-value"
        client = Client(GATEWAY, token=token)
        payload = json.dumps({"errors": [{"code": 9109, "message": token}]}).encode()
        failure = urllib.error.HTTPError("https://api.cloudflare.com/client/v4/zones", 403,
                                         "Forbidden", {}, io.BytesIO(payload))
        client.opener = Mock()
        client.opener.open.side_effect = failure
        with self.assertRaises(RuntimeError) as error:
            client.zone_id()
        message = str(error.exception)
        self.assertIn("GET /zones", message)
        self.assertIn("Zone → Zone → Read", message)
        self.assertIn(GATEWAY["zone"], message)
        self.assertNotIn(token, message)

    def test_zone_failure_does_not_hide_tunnel_denial(self):
        loader = importlib.machinery.SourceFileLoader("gateway_manage_checks", str(ROOT / "gateway/manage"))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        manage = importlib.util.module_from_spec(spec)
        loader.exec_module(manage)
        client = Mock()
        client.verify_token.return_value = {"status": "active"}
        client.zone_id.side_effect = RuntimeError("HTTP 403, error codes [9109]")
        client.configuration.side_effect = RuntimeError("HTTP 401, error codes [10000]")
        output = io.StringIO()
        with patch.object(manage, "Client", return_value=client), \
                patch.object(sys, "argv", ["gateway/manage", "check-credentials"]), redirect_stdout(output):
            with self.assertRaises(RuntimeError):
                manage.main()
        client.configuration.assert_called_once()
        client.records.assert_not_called()
        self.assertIn("[9109]", output.getvalue())
        self.assertIn("[10000]", output.getvalue())
        self.assertIn("SKIP", output.getvalue())

    def test_successful_read_checks_never_claim_or_exercise_write_permissions(self):
        client = Mock()
        client.verify_token.return_value = {"status": "active"}
        client.zone_id.return_value = "zone-1"
        client.configuration.return_value = {"config": ORIGINAL}
        client.records.return_value = []
        messages = []
        check_credentials(client, [ROUTE], emit=messages.append)
        client.records.assert_called_once_with(ROUTE.hostname)
        client.create_record.assert_not_called()
        client.update_configuration.assert_not_called()
        self.assertEqual(sum(x.startswith("PASS") for x in messages), 4)
        self.assertTrue(messages[-1].startswith("NOT TESTED write permissions"))

    def test_account_owned_token_uses_its_verification_endpoint(self):
        client = Client(GATEWAY, token="test-only-credential-value")
        denied = APIError("GET", "/user/tokens/verify", 403, [9109])
        with patch.object(client, "request", side_effect=[denied, {"status": "active"}]) as request:
            self.assertEqual(client.verify_token(), {"status": "active"})
        self.assertEqual(request.call_args_list[1].args,
                         ("GET", f"/accounts/{GATEWAY['account_id']}/tokens/verify"))

    def test_non_numeric_provider_error_codes_cannot_echo_a_credential(self):
        token = "test-only-credential-value"
        client = Client(GATEWAY, token=token)
        payload = json.dumps({"errors": [{"code": token, "message": token}]}).encode()
        client.opener = Mock()
        client.opener.open.side_effect = urllib.error.HTTPError(
            "https://api.cloudflare.com/client/v4/zones", 403, "Forbidden", {}, io.BytesIO(payload))
        with self.assertRaises(RuntimeError) as error:
            client.zone_id()
        self.assertNotIn(token, str(error.exception))
        self.assertIn("error codes []", str(error.exception))


if __name__ == "__main__":
    unittest.main(verbosity=2)
